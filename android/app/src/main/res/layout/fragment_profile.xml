<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- Header & Settings Button -->
    <TextView
        android:id="@+id/tv_profile_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shaxsiy Profil"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"/>

    <ImageView
        android:id="@+id/btn_open_settings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@android:drawable/ic_menu_preferences"
        android:padding="10dp"
        android:background="@drawable/bg_liquid_glass_accent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tv_profile_title"
        app:layout_constraintBottom_toBottomOf="parent"
        android:scrollbars="none"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- User Info Header (100% Circle Avatar & Nickname/Bio Edit) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_liquid_glass"
                android:padding="24dp"
                android:layout_marginBottom="24dp">

                <FrameLayout
                    android:id="@+id/layout_avatar_click"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- 100% Perfectly Rounded Circle Avatar -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_user_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_liquid_glass_accent"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        android:padding="3dp"/>

                    <TextView
                        android:id="@+id/tv_avatar_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="F"
                        android:textColor="@color/white"
                        android:textSize="44sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/bg_liquid_glass_accent"/>

                    <!-- Camera Overlay Badge -->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:src="@android:drawable/ic_menu_camera"
                        android:padding="6dp"
                        android:background="@drawable/bg_liquid_glass_accent"/>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/layout_edit_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="14dp"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/tv_user_nickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Foydalanuvchi"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" ✏️"
                        android:textSize="18sp"/>
                </LinearLayout>

                <!-- User Bio Display -->
                <TextView
                    android:id="@+id/tv_user_bio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI yuz tahlili ishqibozi ✨"
                    android:textColor="@color/colorAccent"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profilni tahrirlash uchun ism yoki avatar ustiga bosing"
                    android:textColor="@color/white_transparent"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- Stat summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_liquid_glass"
                    android:padding="20dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/tv_history_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/colorAccent"
                        android:textSize="28sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jami Tahlillar"
                        android:textColor="@color/white_transparent"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_liquid_glass"
                    android:padding="20dp"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/tv_avg_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/colorPrimary"
                        android:textSize="28sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="O'rtacha Ball"
                        android:textColor="@color/white_transparent"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="O'tgan Tahlillar Tarixi"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Dynamic History List Container -->
            <LinearLayout
                android:id="@+id/layout_history_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_empty_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hali tahlillar bajarilmadi"
                android:textColor="@color/white_transparent"
                android:textSize="15sp"
                android:layout_marginTop="24dp"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
