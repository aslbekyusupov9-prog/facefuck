<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- SCANNING LAYOUT -->
    <LinearLayout
        android:id="@+id/layout_scanning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="visible">

        <FrameLayout
            android:layout_width="250dp"
            android:layout_height="300dp"
            android:background="@drawable/bg_liquid_glass">
            
            <ImageView
                android:id="@+id/iv_scanned_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:alpha="0.7"/>

            <com.aifacerating.app.views.FaceMeshScannerView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sun'iy intellekt yuzingizni tahlil qilmoqda..."
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bu bir necha soniya vaqt olishi mumkin"
            android:textColor="@color/white_transparent"
            android:textSize="14sp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- RESULT LAYOUT -->
    <LinearLayout
        android:id="@+id/layout_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Natija tayyor!"
            android:textColor="@color/colorAccent"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/bg_liquid_glass_accent"
            android:orientation="vertical"
            android:gravity="center"
            android:elevation="8dp">

            <TextView
                android:id="@+id/tv_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="95"
                android:textColor="@color/white"
                android:textSize="64sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/ 100"
                android:textColor="@color/white_transparent"
                android:textSize="18sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mukammal Go'zallik"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yuz tuzilishingiz juda mutanosib. Ayniqsa ko'z va jag' chiziqlari ideallikka yaqin."
            android:textColor="@color/white_transparent"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

        <!-- Detailed Metrics -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp">

            <!-- Item 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/bg_liquid_glass"
                android:padding="16dp"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Simmetriya" android:textColor="@color/white_transparent" android:textSize="12sp"/>
                <TextView android:id="@+id/tv_metric_symmetry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="95%" android:textColor="@color/colorPrimary" android:textStyle="bold" android:textSize="20sp" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Item 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/bg_liquid_glass"
                android:padding="16dp"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teri holati" android:textColor="@color/white_transparent" android:textSize="12sp"/>
                <TextView android:id="@+id/tv_metric_skin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="92%" android:textColor="@color/colorAccent" android:textStyle="bold" android:textSize="20sp" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Item 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/bg_liquid_glass"
                android:padding="16dp"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ko'zlar" android:textColor="@color/white_transparent" android:textSize="12sp"/>
                <TextView android:id="@+id/tv_metric_eyes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="98%" android:textColor="@color/colorPrimary" android:textStyle="bold" android:textSize="20sp" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Item 4 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/bg_liquid_glass"
                android:padding="16dp"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jag' chizig'i" android:textColor="@color/white_transparent" android:textSize="12sp"/>
                <TextView android:id="@+id/tv_metric_jaw" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="90%" android:textColor="@color/colorAccent" android:textStyle="bold" android:textSize="20sp" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Item 5: Golden Ratio -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/bg_liquid_glass"
                android:padding="16dp"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Oltin Nisbat" android:textColor="@color/white_transparent" android:textSize="12sp"/>
                <TextView android:id="@+id/tv_metric_golden" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="94%" android:textColor="@color/colorPrimary" android:textStyle="bold" android:textSize="20sp" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Item 6: Facial Thirds -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/bg_liquid_glass"
                android:padding="16dp"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yuz proporsiyasi" android:textColor="@color/white_transparent" android:textSize="12sp"/>
                <TextView android:id="@+id/tv_metric_thirds" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="88%" android:textColor="@color/colorAccent" android:textStyle="bold" android:textSize="20sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </GridLayout>

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Boshqa rasm tahlil qilish"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_liquid_glass"
            android:textColor="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
